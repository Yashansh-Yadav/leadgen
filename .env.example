# Supabase → Project Settings → API (or Connect). The publishable key is safe in the browser:
# row-level security decides what each logged-in user can see.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# n8n address, for links to audit pages
NEXT_PUBLIC_N8N_BASE_URL=https://NAME.app.n8n.cloud
